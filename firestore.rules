rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Koleksi Kode Verifikasi Guru:
    // Diizinkan dibaca sebelum user login (saat validasi form Register),
    // namun tidak boleh diubah/ditulis dari sisi client.
    match /admin_codes/{codeId} {
      allow read: if true;
      allow write: if false;
    }

    // Koleksi Data Pengguna:
    // Hanya pemilik akun (uid yang sama) yang boleh membaca dan menulis datanya sendiri.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Tolak akses ke koleksi lain secara default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
